# Copy to .env to override defaults used by docker-compose.yml
POSTGRES_PASSWORD=orders_dev_password
GATEWAY_PORT=8080

# Background job: requirement is every 5 minutes (300). Use e.g. 30 for a quick demo.
WORKER_INTERVAL_SECONDS=300
WORKER_RUN_ON_STARTUP=false

# Seconds a PENDING order must exist before the job promotes it (0 = promote all on each run)
MIN_PENDING_AGE_SECONDS=0

# Only used with docker-compose.tools.yml (database browsing tools, bound to 127.0.0.1)
DB_PORT=5433
PGADMIN_PORT=5050
